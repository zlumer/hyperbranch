{
  "name": "cli",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "tsx server/main.ts",
    "gen": "tsx server/router-gen.ts",
	"build": "tsdown && node -e \"const fs=require('fs'); if(fs.existsSync('dist/hb.mjs')) fs.renameSync('dist/hb.mjs', 'dist/hb.js'); const file='dist/hb.js'; fs.writeFileSync(file, fs.readFileSync(file, 'utf8').replace('#!/usr/bin/env -S npx -y tsx', '#!/usr/bin/env node'))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@opencode-ai/sdk": "^1.3.0",
    "@orpc/openapi": "^1.13.9",
    "@orpc/server": "^1.13.9",
    "@orpc/zod": "^1.13.9",
    "cmd-ts": "^0.15.0",
    "execa": "^9.6.1",
    "hono": "^4.12.9",
    "lodash.merge": "^4.6.2",
    "orpc-file-based-router": "^0.1.7",
    "toml": "^3.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "node-pty": "^1.1.0",
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
